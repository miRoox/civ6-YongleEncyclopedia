<?xml version="1.0" encoding="utf-8"?>
<GameInfo>
  <BaseGameText>
    <Row Tag="LOC_GREAT_PERSON_INDIVIDUAL_XIE_JIN_NAME" Text="Xie Jin" />
    <Row Tag="LOC_GREAT_PERSON_INDIVIDUAL_XIE_JIN_DESCRIPTION" Text="Renaissance Great Writer. Activating him creates the Great Work 'Yongle Encyclopedia'." />

    <Row Tag="LOC_GREATWORK_YONGLE_ENCYCLOPEDIA_NAME" Text="Yongle Encyclopedia" />
    <Row Tag="LOC_GREATWORK_YONGLE_ENCYCLOPEDIA_QUOTE" Text="An imperial compendium to capture the origin of all things. Grants a Eureka for every technology when created." />

    <Row Tag="LOC_GREATWORK_YONGLE_FRAGMENT_1_NAME" Text="Yongle Encyclopedia Fragment" />
    <Row Tag="LOC_GREATWORK_YONGLE_FRAGMENT_1_QUOTE" Text="Even a surviving page can spark inspiration, granting multiple Eurekas of the current era." />
  </BaseGameText>
  <LocalizedText>
    <Row Language="zh_Hans_CN" Tag="LOC_GREAT_PERSON_INDIVIDUAL_XIE_JIN_NAME" Text="解缙" />
    <Row Language="zh_Hans_CN" Tag="LOC_GREAT_PERSON_INDIVIDUAL_XIE_JIN_DESCRIPTION" Text="文艺复兴时代大作家。激活后创建文学巨作《永乐大典》。" />

    <Row Language="zh_Hans_CN" Tag="LOC_GREATWORK_YONGLE_ENCYCLOPEDIA_NAME" Text="《永乐大典》" />
    <Row Language="zh_Hans_CN" Tag="LOC_GREATWORK_YONGLE_ENCYCLOPEDIA_QUOTE" Text="钦定大典，纂辑万物起源，创作时获得所有科技的尤里卡。" />

    <Row Language="zh_Hans_CN" Tag="LOC_GREATWORK_YONGLE_FRAGMENT_1_NAME" Text="《永乐大典》残篇" />
    <Row Language="zh_Hans_CN" Tag="LOC_GREATWORK_YONGLE_FRAGMENT_1_QUOTE" Text="残片亦可窥全豹，偶得灵光之启，能带来多个当代科技的尤里卡。" />
  </LocalizedText>
</GameInfo>
